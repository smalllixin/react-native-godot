+#include "rendering_native_surface_apple.h"
+#ifdef METAL_ENABLED
+#include "drivers/metal/rendering_context_driver_metal.h"
+#import <QuartzCore/CAMetalLayer.h>
+#endif
+void RenderingNativeSurfaceApple::_bind_methods() {
+    ClassDB::bind_static_method("RenderingNativeSurfaceApple", D_METHOD("create", "layer"), &RenderingNativeSurfaceApple::create);
+    ClassDB::bind_method(D_METHOD("get_layer"), &RenderingNativeSurfaceApple::get_layer);
+}
+Ref<RenderingNativeSurfaceApple> RenderingNativeSurfaceApple::create(int64_t existing) {
+    Ref<RenderingNativeSurfaceApple> result; result.instantiate();
+#ifdef METAL_ENABLED
+    if (existing) result->layer = (__bridge_retained void *)(__bridge id)(void *)existing;
+    else {
+        __block CAMetalLayer *new_layer;
+        void (^create_layer)(void) = ^{ new_layer = [CAMetalLayer layer]; };
+        if ([NSThread isMainThread]) create_layer(); else dispatch_sync(dispatch_get_main_queue(), create_layer);
+        result->layer = (__bridge_retained void *)new_layer;
+    }
+#endif
+    return result;
+}
+RenderingContextDriver *RenderingNativeSurfaceApple::create_rendering_context(const String &driver) {
+#ifdef METAL_ENABLED
+    if (driver == "metal") return memnew(RenderingContextDriverMetal);
+#endif
+    return nullptr;
+}
+RenderingNativeSurfaceApple::~RenderingNativeSurfaceApple() {
+    if (layer) { CFRelease(layer); layer = nullptr; }
+}
