diff --git a/platform/android/libgodot_android.cpp b/platform/android/libgodot_android.cpp
new file mode 100644
index 0000000..7123e82
--- /dev/null
+++ b/platform/android/libgodot_android.cpp
@@ -0,0 +1,54 @@
+// Android host initialization adapted from Migeran's embedding extension.
+#include "libgodot_android.h"
+#include "core/extension/godot_instance.h"
+#include "main/main.h"
+#include "dir_access_jandroid.h"
+#include "file_access_android.h"
+#include "file_access_filesystem_jandroid.h"
+#include "java_godot_io_wrapper.h"
+#include "java_godot_wrapper.h"
+#include "api/java_class_wrapper.h"
+#include "net_socket_android.h"
+#include "os_android.h"
+#include "thread_jandroid.h"
+#include "jni_utils.h"
+#include "servers/audio/audio_server.h"
+static GodotInstance *instance = nullptr;
+static OS_Android *embedded_os = nullptr;
+static GodotIOJavaWrapper *io = nullptr;
+static GodotJavaWrapper *wrapper = nullptr;
+static JavaClassWrapper *classes = nullptr;
+static void release_host() {
+    delete embedded_os; embedded_os = nullptr;
+    delete io; io = nullptr;
+    delete wrapper; wrapper = nullptr;
+    FileAccessAndroid::terminate(); DirAccessJAndroid::terminate();
+    FileAccessFilesystemJAndroid::terminate(); NetSocketAndroid::terminate();
+    cleanup_android_class_loader(); AudioDriverManager::reset();
+}
+extern "C" LIBGODOT_API GDExtensionObjectPtr libgodot_create_godot_instance_android(int argc, char *argv[], GDExtensionInitializationFunction init, JNIEnv *env, jobject assets, jobject net, jobject dirs, jobject files, jobject godot_io, jobject godot_bridge, jobject loader) {
+    ERR_FAIL_COND_V(instance || argc < 1, nullptr);
+    JavaVM *vm = nullptr; env->GetJavaVM(&vm);
+    init_thread_jandroid(vm, env); setup_android_class_loader(loader);
+    AudioDriverManager::reset();
+    FileAccessAndroid::setup(assets); DirAccessJAndroid::setup(dirs);
+    FileAccessFilesystemJAndroid::setup(files); NetSocketAndroid::setup(net);
+    io = new GodotIOJavaWrapper(env, godot_io);
+    wrapper = new GodotJavaWrapper(env, godot_bridge);
+    embedded_os = new OS_Android(wrapper, io, false);
+    if (Main::setup(argv[0], argc - 1, &argv[1], false) != OK) { release_host(); return nullptr; }
+    classes = memnew(JavaClassWrapper);
+    instance = memnew(GodotInstance);
+    if (!instance->initialize(init)) {
+        memdelete(instance); instance = nullptr;
+        memdelete(classes); classes = nullptr;
+        Main::cleanup(); release_host(); return nullptr;
+    }
+    return (GDExtensionObjectPtr)instance;
+}
+extern "C" LIBGODOT_API void libgodot_destroy_godot_instance(GDExtensionObjectPtr ptr) {
+    if (!instance || ptr != instance) return;
+    instance->stop(); memdelete(instance); instance = nullptr;
+    memdelete(classes); classes = nullptr;
+    Main::cleanup(); release_host();
+}
