+#include "core/extension/godot_instance.h"
+#include "core/extension/libgodot.h"
+#include "main/main.h"
+#include "core/io/logger.h"
+#include <cstdio>
+#include "core/extension/libgodot_embedding.h"
+#include "servers/audio/audio_server.h"
+#import "os_ios.h"
+static GodotInstance *instance = nullptr;
+static LibGodotHostLog host_log = nullptr;
+static void *host_log_data = nullptr;
+int libgodot_embedding_api_version() { return 1; }
+void libgodot_set_log_callback(LibGodotHostLog callback, void *data) {
+    host_log = callback; host_log_data = data;
+}
+class HostLogger : public Logger {
+public:
+    void logv(const char *format, va_list args, bool error) override {
+        if (!host_log) return;
+        char message[4096]; vsnprintf(message, sizeof(message), format, args);
+        host_log(host_log_data, message, error);
+    }
+};
+GDExtensionObjectPtr libgodot_create_godot_instance(int argc, char *argv[], GDExtensionInitializationFunction init) {
+    ERR_FAIL_COND_V(instance != nullptr || argc < 1, nullptr);
+    AudioDriverManager::reset();
+    OS_IOS *os = new OS_IOS();
+    os->add_logger(memnew(HostLogger));
+    Error error = Main::setup(argv[0], argc - 1, &argv[1], false);
+    if (error != OK) { delete os; return nullptr; }
+    instance = memnew(GodotInstance);
+    if (!instance->initialize(init)) {
+        memdelete(instance); instance = nullptr; Main::cleanup(); delete os; return nullptr;
+    }
+    os->initialize_modules();
+    return (GDExtensionObjectPtr)instance;
+}
+void libgodot_destroy_godot_instance(GDExtensionObjectPtr ptr) {
+    if (!instance || ptr != instance) return;
+    instance->stop(); memdelete(instance); instance = nullptr;
+    Main::cleanup(); delete OS_IOS::get_singleton();
+}
