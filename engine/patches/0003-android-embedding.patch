+++ b/servers/rendering/rendering_native_surface_android.cpp
@@ -0,0 +1,89 @@
+// Android surfaces preserve the Migeran bridge interface with upstream 4.7 rendering.
+#include "rendering_native_surface_android.h"
+#include "gl_manager.h"
+#if defined(ANDROID_ENABLED)
+#include <android/native_window.h>
+#if defined(VULKAN_ENABLED)
+#include "platform/android/rendering_context_driver_vulkan_android.h"
+#endif
+#if defined(GLES3_ENABLED)
+#include <EGL/egl.h>
+class EmbeddedGLAndroid : public GLManager {
+    EGLDisplay display = EGL_NO_DISPLAY;
+    EGLContext context = EGL_NO_CONTEXT;
+    EGLConfig config = nullptr;
+    struct Window { EGLSurface surface = EGL_NO_SURFACE; Size2i size; Ref<RenderingNativeSurface> native; };
+    HashMap<int, Window> windows;
+    int current = -1;
+    bool vsync = true;
+public:
+    Error initialize(void * = nullptr) override {
+        display = eglGetDisplay(EGL_DEFAULT_DISPLAY);
+        if (display == EGL_NO_DISPLAY || !eglInitialize(display, nullptr, nullptr)) return ERR_CANT_CREATE;
+        eglBindAPI(EGL_OPENGL_ES_API);
+        EGLint attrs[] = {EGL_SURFACE_TYPE, EGL_WINDOW_BIT, EGL_RENDERABLE_TYPE, EGL_OPENGL_ES3_BIT, EGL_RED_SIZE,8,EGL_GREEN_SIZE,8,EGL_BLUE_SIZE,8,EGL_ALPHA_SIZE,8,EGL_DEPTH_SIZE,24,EGL_NONE};
+        EGLint count = 0;
+        if (!eglChooseConfig(display, attrs, &config, 1, &count) || count == 0) return ERR_CANT_CREATE;
+        EGLint ctx[] = {EGL_CONTEXT_CLIENT_VERSION,3,EGL_NONE};
+        context = eglCreateContext(display, config, EGL_NO_CONTEXT, ctx);
+        return context == EGL_NO_CONTEXT ? ERR_CANT_CREATE : OK;
+    }
+    Error open_display(void *) override { return OK; }
+    Error window_create(int id, Ref<RenderingNativeSurface> native, int, int) override {
+        auto *android = Object::cast_to<RenderingNativeSurfaceAndroid>(native.ptr());
+        ERR_FAIL_NULL_V(android, ERR_INVALID_PARAMETER);
+        Window w; w.native = native; w.size = Size2i(android->get_width(), android->get_height());
+        EGLint format; eglGetConfigAttrib(display, config, EGL_NATIVE_VISUAL_ID, &format);
+        ANativeWindow_setBuffersGeometry(android->get_window(), w.size.x, w.size.y, format);
+        w.surface = eglCreateWindowSurface(display, config, android->get_window(), nullptr);
+        if (w.surface == EGL_NO_SURFACE) return ERR_CANT_CREATE;
+        windows[id] = w; window_make_current(id); return OK;
+    }
+    void window_resize(int id, int w, int h) override { if (windows.has(id)) windows[id].size = Size2i(w,h); }
+    void window_destroy(int id) override { if (!windows.has(id)) return; if(current==id) release_current(); eglDestroySurface(display,windows[id].surface); windows.erase(id); }
+    Size2i window_get_size(int id) const override { return windows.has(id) ? windows[id].size : Size2i(); }
+    int window_get_render_target(int) const override { return 0; }
+    int window_get_color_texture(int) const override { return 0; }
+    void release_current() override { eglMakeCurrent(display,EGL_NO_SURFACE,EGL_NO_SURFACE,EGL_NO_CONTEXT); current=-1; }
+    void swap_buffers() override { if(windows.has(current)) eglSwapBuffers(display,windows[current].surface); }
+    void window_make_current(int id) override { if(!windows.has(id)) return; current=id; eglMakeCurrent(display,windows[id].surface,windows[id].surface,context); eglSwapInterval(display,vsync?1:0); }
+    void set_use_vsync(bool use) override { vsync=use; if(current>=0) eglSwapInterval(display,use?1:0); }
+    bool is_using_vsync() const override { return vsync; }
+    bool validate_driver() const override { return true; }
+    ~EmbeddedGLAndroid() override { release_current(); for (auto &entry : windows) eglDestroySurface(display,entry.value.surface); windows.clear(); if(context!=EGL_NO_CONTEXT) eglDestroyContext(display,context); if(display!=EGL_NO_DISPLAY) eglTerminate(display); }
+};
+#endif
+#endif
+void RenderingNativeSurfaceAndroid::_bind_methods() {
+    ClassDB::bind_static_method("RenderingNativeSurfaceAndroid",D_METHOD("create","window","width","height"),&RenderingNativeSurfaceAndroid::create_api);
+    ClassDB::bind_method(D_METHOD("get_window"),&RenderingNativeSurfaceAndroid::get_window_api);
+    ClassDB::bind_method(D_METHOD("get_width"),&RenderingNativeSurfaceAndroid::get_width);
+    ClassDB::bind_method(D_METHOD("get_height"),&RenderingNativeSurfaceAndroid::get_height);
+}
+Ref<RenderingNativeSurfaceAndroid> RenderingNativeSurfaceAndroid::create_api(uint64_t w,uint32_t width,uint32_t height) { return create((ANativeWindow *)w,width,height); }
+Ref<RenderingNativeSurfaceAndroid> RenderingNativeSurfaceAndroid::create(ANativeWindow *w,uint32_t width,uint32_t height) {
+    Ref<RenderingNativeSurfaceAndroid> result; result.instantiate(); result->window=w;result->width=width;result->height=height;
+#ifdef ANDROID_ENABLED
+    if(w) ANativeWindow_acquire(w);
+#endif
+    return result;
+}
+RenderingContextDriver *RenderingNativeSurfaceAndroid::create_rendering_context(const String &driver) {
+#if defined(ANDROID_ENABLED) && defined(VULKAN_ENABLED)
+    if(driver=="vulkan") return memnew(RenderingContextDriverVulkanAndroid);
+#endif
+    return nullptr;
+}
+GLManager *RenderingNativeSurfaceAndroid::create_gl_manager(const String &driver) {
+#if defined(ANDROID_ENABLED) && defined(GLES3_ENABLED)
+    if(driver=="opengl3") return memnew(EmbeddedGLAndroid);
+#endif
+    return nullptr;
+}
+void *RenderingNativeSurfaceAndroid::get_native_id() const {return window;}
+RenderingNativeSurfaceAndroid::RenderingNativeSurfaceAndroid() {}
+RenderingNativeSurfaceAndroid::~RenderingNativeSurfaceAndroid() {
+#ifdef ANDROID_ENABLED
+    if(window) ANativeWindow_release(window);
+#endif
+}
